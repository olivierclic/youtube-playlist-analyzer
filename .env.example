# --- Backend ---
PORT=3000
# Origine autorisée pour CORS (URL du frontend). En dev Vite : http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Clés API (peuvent être écrasées depuis l'UI Réglages, stockées alors en base) ---
# YouTube Data API v3 (obligatoire pour lister les vidéos)
YOUTUBE_API_KEY=

# OpenRouter (optionnel — résumés IA)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Apify (optionnel — transcriptions)
APIFY_TOKEN=
APIFY_ACTOR=vKlQCAJRI72MdyK1u

# --- Chemin base SQLite (volume Docker) ---
DB_PATH=./data/youtube.db

# --- Frontend (Docker) ---
# Port hôte pour accéder au frontend sans Traefik
FRONTEND_PORT=8080
